<Project Sdk="Microsoft.NET.Sdk">

  <!-- Build from the Unity editor (Modkit > Mods), with `modkit build`, or by hand with
       -p:"ModkitGameDir=/path/to/Approximately Up" (or MODKIT_GAME_DIR set). -->

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>FastForwardPlus</AssemblyName>
    <RootNamespace>FastForwardPlus</RootNamespace>
    <Version>1.0.0</Version>
    <Authors>CohoJET</Authors>
    <Description>Sets the simulation speed to any of a configurable list of multipliers with a hotkey.</Description>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>

    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>

    <!-- Trailing `~` keeps Unity's AssetDatabase from ever seeing the build output. -->
    <BaseOutputPath>bin~\</BaseOutputPath>
    <RestoreOutputPath>obj~\</RestoreOutputPath>

    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <PropertyGroup>
    <ModkitGameDir Condition="'$(ModkitGameDir)' == ''">$(MODKIT_GAME_DIR)</ModkitGameDir>
    <ModkitBepInExCoreDir Condition="'$(ModkitBepInExCoreDir)' == '' and '$(ModkitGameDir)' != ''">$(ModkitGameDir)/BepInEx/core</ModkitBepInExCoreDir>
    <ModkitInteropDir Condition="'$(ModkitInteropDir)' == '' and '$(ModkitGameDir)' != ''">$(ModkitGameDir)/BepInEx/interop</ModkitInteropDir>
  </PropertyGroup>

  <Target Name="ModkitCheckReferences" BeforeTargets="BeforeBuild">
    <Error Condition="'$(ModkitGameDir)' == '' and '$(ModkitInteropDir)' == ''"
           Text="Nothing said where the game is. Build this mod from the Unity editor (Modkit &gt; Mods), with `modkit build`, or pass -p:&quot;ModkitGameDir=&lt;the folder holding GameAssembly.dll&gt;&quot;." />
    <Error Condition="!Exists('$(ModkitInteropDir)')"
           Text="No interop assemblies at $(ModkitInteropDir). Install BepInEx into the game folder and launch the game once so it generates them." />
    <Error Condition="!Exists('$(ModkitBepInExCoreDir)/BepInEx.Unity.IL2CPP.dll')"
           Text="No BepInEx.Unity.IL2CPP.dll at $(ModkitBepInExCoreDir). This mod needs a BepInEx install in the game folder." />
  </Target>

  <!-- Referenced live out of the BepInEx install; Private=false since BepInEx
       has already loaded it all by the time the mod runs. -->
  <ItemGroup Condition="Exists('$(ModkitInteropDir)')">
    <Reference Include="$(ModkitBepInExCoreDir)/BepInEx.Core.dll" Private="false" />
    <Reference Include="$(ModkitBepInExCoreDir)/BepInEx.Unity.Common.dll" Private="false" />
    <Reference Include="$(ModkitBepInExCoreDir)/BepInEx.Unity.IL2CPP.dll" Private="false" />
    <Reference Include="$(ModkitBepInExCoreDir)/0Harmony.dll" Private="false" />
    <Reference Include="$(ModkitBepInExCoreDir)/Il2CppInterop.Runtime.dll" Private="false" />
    <Reference Include="$(ModkitBepInExCoreDir)/Il2CppInterop.Common.dll" Private="false" />
    <Reference Include="$(ModkitBepInExCoreDir)/Il2CppInterop.HarmonySupport.dll" Private="false" />
    <Reference Include="$(ModkitInteropDir)/*.dll" Private="false" />
  </ItemGroup>

</Project>
